# Copy this file to backend/.env (that exact name) and put your key THERE.
# backend/.env is gitignored. This file is NOT - never put a real key here.
#
#   cp backend/env.sample backend/.env
#   # then edit backend/.env and paste your key in directly

# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=your-gemini-api-key-here

# Defaults target Gemini's OpenAI-compatible endpoint. To switch providers
# later (OpenAI, Groq, a local Ollama, etc.), change these three lines only -
# app/llm.py doesn't need to change.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
